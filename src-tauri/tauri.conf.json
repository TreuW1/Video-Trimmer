{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VideoTrimmer",
  "version": "1.0.5",
  "identifier": "com.videoeditor",
  "build": {
    "frontendDist": "../video-editor-frontend/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix video-editor-frontend",
    "beforeBuildCommand": "npm run build:backend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Video Trimmer",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#030712",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:3000; media-src 'self' asset: https://asset.localhost http://asset.localhost blob: data: http://127.0.0.1:3000 tauri: https://tauri.localhost; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob: tauri: https://tauri.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "backend-dist": "backend-dist",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../licenses/NODE_LICENSE.txt": "NODE_LICENSE.txt",
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "copyright": "Copyright © 2026 TreuW1",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Video Trimmer",
    "longDescription": "Video Trimmer Application",

    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
